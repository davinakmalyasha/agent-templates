name: Security Gate

permissions:
  contents: read

on:
  push:
  pull_request:

concurrency:
  group: gate
  cancel-in-progress: true

jobs:
  sast:
    name: sast
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
        with:
          persist-credentials: false
      - uses: actions/setup-go@40f1582b2485089dde7abd97c1529aa768e1baff # v5
        with:
          go-version: '{{ go_version }}'
      - name: staticcheck (SAST) — fail on findings
        run: |
          if [ -f go.mod ]; then
            go run honnef.co/go/tools/cmd/staticcheck@{{ staticcheck_version }} ./... || exit 1
          else
            echo "no go.mod — skipped"
          fi

  sca:
    name: sca
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
        with:
          persist-credentials: false
      - uses: actions/setup-go@40f1582b2485089dde7abd97c1529aa768e1baff # v5
        with:
          go-version: '{{ go_version }}'
      - name: govulncheck (SCA) — fail on known CVEs
        run: |
          if [ -f go.mod ]; then
            go run golang.org/x/vuln/cmd/govulncheck@latest ./... || exit 1
          else
            echo "no go.mod — skipped"
          fi

  secrets:
    name: secrets
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
        with:
          persist-credentials: false
      - name: gitleaks — fail on any leaked secret
        run: |
          curl -sSfL https://github.com/gitleaks/gitleaks/releases/download/v{{ gitleaks_version }}/gitleaks_{{ gitleaks_version }}_linux_x64.tar.gz -o /tmp/gitleaks.tar.gz
          tar -xzf /tmp/gitleaks.tar.gz -C /tmp
          /tmp/gitleaks detect --source . --redact --exit-code 1

  quality:
    name: quality
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
        with:
          persist-credentials: false
      - uses: actions/setup-go@40f1582b2485089dde7abd97c1529aa768e1baff # v5
        with:
          go-version: '{{ go_version }}'
      - name: gofmt + go vet
        run: |
          if [ -f go.mod ]; then
            [ -z "$(gofmt -l . | tee /dev/stderr)" ] || exit 1
            go vet ./... || exit 1
          else
            echo "no go.mod — skipped"
          fi

  coverage:
    name: coverage
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
        with:
          persist-credentials: false
      - uses: actions/setup-go@40f1582b2485089dde7abd97c1529aa768e1baff # v5
        with:
          go-version: '{{ go_version }}'
      - name: go test + coverage threshold
        run: |
          if [ -f go.mod ]; then
            if find . -name '*_test.go' -not -path './vendor/*' | grep -q .; then
              go test ./... -coverprofile=/tmp/cover.out || exit 1
              go tool cover -func=/tmp/cover.out | awk -v t={{ coverage_threshold }} '$1 == "total:" { gsub("%", "", $3); if ($3 + 0 < t) { print "coverage " $3 "% below threshold " t "%"; exit 1 } }' || exit 1
            else
              echo "no test files — coverage skipped"
            fi
          else
            echo "no go.mod — skipped"
          fi

  semgrep:
    name: semgrep
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
        with:
          persist-credentials: false
      - uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065 # v5
        with:
          python-version: '3.12'
      - name: Semgrep (p/security-audit) — fail on findings
        run: |
          pip install --quiet semgrep
          semgrep scan --config p/security-audit --error --quiet --metrics=off .
{% if codeql_on == 'true' or codeql_on == True %}
  codeql:
    name: codeql
    runs-on: ubuntu-latest
    permissions:
      contents: read
      security-events: write
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
        with:
          persist-credentials: false
      - uses: github/codeql-action/init@d6317709a54fd87078d323eeb0e48ec331c8e621 # v3
        with:
          languages: go
      - uses: github/codeql-action/analyze@d6317709a54fd87078d323eeb0e48ec331c8e621 # v3
{% endif %}
  zizmor:
    name: zizmor
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
        with:
          persist-credentials: false
      - name: zizmor — audit the repo's own workflows
        run: |
          curl -sSfL https://github.com/woodruffw/zizmor/releases/download/v{{ zizmor_version }}/zizmor-x86_64-unknown-linux-gnu.tar.gz -o /tmp/zizmor.tar.gz
          tar -xzf /tmp/zizmor.tar.gz -C /tmp
          /tmp/zizmor --min-severity medium .
