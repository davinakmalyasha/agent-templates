name: Perf Load

permissions:
  contents: read

on:
  workflow_dispatch:

concurrency:
  group: perf-load
  cancel-in-progress: true

jobs:
  load:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
        with:
          persist-credentials: false
      - name: k6 load test
        run: |
          curl -sSfL https://github.com/grafana/k6/releases/download/v{{ k6_version }}/k6-v{{ k6_version }}-linux-amd64.tar.gz -o /tmp/k6.tar.gz
          tar -xzf /tmp/k6.tar.gz -C /tmp
          /tmp/k6-v{{ k6_version }}-linux-amd64/k6 run {{ script_path }}
