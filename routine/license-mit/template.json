{
  "name": "license-mit",
  "description": "MIT license text with the year and holder filled in.",
  "category": "routine",
  "variables": [
    {"name": "holder", "type": "string", "required": true, "description": "Copyright holder, e.g. 'Davin Akmal Yasha'"},
    {"name": "year", "type": "string", "default": "2026", "description": "Copyright year"}
  ],
  "files": [
    {"src": "LICENSE.j2", "dest": "LICENSE"}
  ],
  "notes": "MIT is the default choice for public repos. Swap for Apache-2.0/GPL if you prefer.",
  "sample_vars": {"holder": "Davin Akmal Yasha", "year": "2026"}
}
