"""Service layer for {{ feature_name }} CRUD."""
from fastapi import HTTPException
from sqlalchemy.orm import Session

from ..models.{{ feature_name|lower }} import {{ feature_name }}


def create_{{ feature_name|lower }}(db: Session, data) -> {{ feature_name }}:
    item = {{ feature_name }}(**data.model_dump(exclude_none=True))
