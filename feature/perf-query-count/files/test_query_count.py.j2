# ruff: noqa: S101
"""Query-count smoke: SQLAlchemy event counter per request (N+1 catcher)."""

import importlib

import pytest

QUERY_BUDGET = {{ query_budget }}

try:
    from fastapi.testclient import TestClient

    app = importlib.import_module("{{ package_name }}.main").app
    engine = importlib.import_module("{{ package_name }}.database").engine
    HAVE_APP = True
except Exception:
    HAVE_APP = False


@pytest.mark.skipif(not HAVE_APP, reason="no FastAPI app at {{ package_name }}.main")
def test_query_count_on_health():
    from sqlalchemy import event

    counts = {"n": 0}

    def _count(conn, *args):
        counts["n"] += 1

    event.listen(engine, "before_cursor_execute", _count)
    try:
        client = TestClient(app)
        client.get("/health")
    finally:
        event.remove(engine, "before_cursor_execute", _count)
    assert counts["n"] <= QUERY_BUDGET, (
        f"/health issued {counts['n']} queries (budget {QUERY_BUDGET}) — likely N+1"
    )
