# ruff: noqa: S101
"""Memory smoke: tracemalloc peak-delta budget around the package import."""

import importlib
import tracemalloc

import pytest

MEM_BUDGET_MB = {{ mem_budget_mb }}
PACKAGE = "{{ package_name }}"


def test_import_memory_delta():
    try:
        importlib.import_module(PACKAGE)
    except Exception:
        pytest.skip(f"package '{PACKAGE}' not present yet")
    tracemalloc.start()
    try:
        importlib.import_module(PACKAGE)
        _, peak = tracemalloc.get_traced_memory()
    finally:
        tracemalloc.stop()
    peak_mb = peak / (1024 * 1024)
    assert peak_mb < MEM_BUDGET_MB, (
        f"import of {PACKAGE} peaked at {peak_mb:.1f}MB (budget {MEM_BUDGET_MB}MB)"
    )
