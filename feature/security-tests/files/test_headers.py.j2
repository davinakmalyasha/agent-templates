# ruff: noqa: S101
"""Security-header tests: a well-configured app sets the basics.

FAILING this test is the intended gate behavior — the fix is adding the
security middleware, not loosening the test.
"""

import importlib

import pytest

try:
    from fastapi.testclient import TestClient

    app = importlib.import_module("{{ package_name }}.main").app
    client = TestClient(app)
    HAVE_APP = True
except Exception:
    HAVE_APP = False

REQUIRED_HEADERS = ("x-content-type-options", "x-frame-options", "referrer-policy")


@pytest.mark.skipif(not HAVE_APP, reason="no FastAPI app at {{ package_name }}.main")
@pytest.mark.parametrize("header", REQUIRED_HEADERS)
def test_security_headers_present(header):
    response = client.get("/health")
    assert header in response.headers, (
        f"missing {header} — add security headers middleware "
        "(e.g. fastapi middleware or a header injection in the app)"
    )
