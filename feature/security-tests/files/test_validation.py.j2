# ruff: noqa: S101
"""Input-validation security tests: hostile payloads must never 500."""

import importlib

import pytest

try:
    from fastapi.testclient import TestClient

    app = importlib.import_module("{{ package_name }}.main").app
    client = TestClient(app)
    HAVE_APP = True
except Exception:
    HAVE_APP = False

HOSTILE_PAYLOADS = [
    None,
    "not-json",
    {"id": "x" * 10000},
    {"__proto__": {"polluted": True}},
    {"constructor": {"prototype": {"x": 1}}},
]


@pytest.mark.skipif(not HAVE_APP, reason="no FastAPI app at {{ package_name }}.main")
@pytest.mark.parametrize("payload", HOSTILE_PAYLOADS)
def test_malformed_payloads_never_500(payload):
    for route in ("/", "{{ api_prefix }}"):
        response = client.post(route, json=payload)
        assert response.status_code < 500, f"{route} returned 500 for {payload!r}"


@pytest.mark.skipif(not HAVE_APP, reason="no FastAPI app")
def test_query_string_abuse_never_500():
    for query in ("?page=99999999999999999999", "?q=" + "a" * 100000, "?sort=;DROP TABLE users--"):
        response = client.get("{{ api_prefix }}" + query)
        assert response.status_code < 500, f"500 for {query}"
