# ruff: noqa: S101, S112
"""Repo scan for plaintext secrets — deterministic, no dependencies."""

import pathlib
import re

ROOT = pathlib.Path(__file__).resolve().parent.parent
SKIP_DIRS = {".git", "venv", "venv312", "node_modules", ".venv", "__pycache__", ".pytest_cache"}

PATTERNS = {
    "aws access key": re.compile(r"AKIA[0-9A-Z]{16}"),
    "github token": re.compile(r"ghp_[A-Za-z0-9]{36}"),
    "private key header": re.compile(r"-----BEGIN (RSA |EC |OPENSSH )?PRIVATE KEY-----"),
    "generic password field": re.compile(r"(?i)(password|passwd|secret|api[_-]?key)\s*[:=]\s*['\"][^'\"]{8,}['\"]"),
}


def test_no_plaintext_secrets_in_source():
    hits = []
    for path in ROOT.rglob("*"):
        if not path.is_file() or any(part in SKIP_DIRS for part in path.parts):
            continue
        try:
            text = path.read_text(encoding="utf-8", errors="replace")
        except Exception:
            continue
        for name, pattern in PATTERNS.items():
            for match in pattern.finditer(text):
                # allow test fixtures that intentionally contain patterns
                if "test" in path.name or "fixture" in str(path):
                    continue
                hits.append(f"{path.relative_to(ROOT)}:{match.start()}: {name}")
    assert not hits, "plaintext secrets found:\n" + "\n".join(hits[:20])
