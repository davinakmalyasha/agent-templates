"""Minimal PDF report builder — reportlab (requires: pip install reportlab)."""
from typing import List, Optional

from reportlab.lib import colors
from reportlab.lib.pagesizes import A4
from reportlab.lib.styles import ParagraphStyle, getSampleStyleSheet
from reportlab.lib.units import mm
from reportlab.platypus import (
    PageBreak,
    Paragraph,
    SimpleDocTemplate,
    Spacer,
    Table,
    TableStyle,
)


def build_pdf(
    path: str,
    title: str,
    sections: Optional[List[tuple]] = None,
    tables: Optional[List[dict]] = None,
) -> None:
    """Write a PDF. sections = [(heading, paragraph_text), ...],
    tables = [{'headers': [...], 'rows': [[...], ...]}, ...]."""
    styles = getSampleStyleSheet()
    title_style = ParagraphStyle("TitleX", parent=styles["Title"], fontSize=18, spaceAfter=12)
    heading_style = ParagraphStyle("H2X", parent=styles["Heading2"], spaceBefore=12)
    body_style = ParagraphStyle("BodyX", parent=styles["BodyText"], fontSize=10)

    story = [Paragraph(title, title_style), Spacer(1, 4 * mm)]
    for heading, text in (sections or []):
        story.append(Paragraph(heading, heading_style))
        story.append(Paragraph(text, body_style))
    for table in (tables or []):
        headers = table.get("headers", [])
        data = [headers] + table.get("rows", [])
        tbl = Table(data, repeatRows=1)
        tbl.setStyle(TableStyle([
            ("BACKGROUND", (0, 0), (-1, 0), colors.HexColor("#4F81BD")),
            ("TEXTCOLOR", (0, 0), (-1, 0), colors.white),
            ("GRID", (0, 0), (-1, -1), 0.5, colors.grey),
            ("FONTSIZE", (0, 0), (-1, -1), 9),
            ("ROWBACKGROUNDS", (0, 1), (-1, -1), [colors.white, colors.HexColor("#F2F6FC")]),
        ]))
        story.append(Spacer(1, 4 * mm))
        story.append(tbl)
        story.append(PageBreak())

    doc = SimpleDocTemplate(path, pagesize=A4, rightMargin=15 * mm, leftMargin=15 * mm,
                            topMargin=15 * mm, bottomMargin=15 * mm)
    doc.build(story)
