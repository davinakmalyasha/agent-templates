"""Excel export helpers — openpyxl workbook builder (requires: pip install openpyxl)."""
from openpyxl import Workbook
from openpyxl.styles import Font, PatternFill
from openpyxl.utils import get_column_letter


def build_workbook(sheets: dict) -> Workbook:
    """Build a workbook from {'SheetName': [list-of-dicts], ...}. Headers styled + autosized."""
    wb = Workbook()
    wb.remove(wb.active)
    header_font = Font(bold=True, color="FFFFFF")
    header_fill = PatternFill("solid", fgColor="4F81BD")
    for sheet_name, rows in sheets.items():
        ws = wb.create_sheet(title=str(sheet_name)[:31])
        rows = list(rows or [])
        if not rows:
            continue
        columns = list(rows[0].keys())
        for col, header in enumerate(columns, start=1):
            cell = ws.cell(row=1, column=col, value=header)
            cell.font = header_font
            cell.fill = header_fill
        for r, row in enumerate(rows, start=2):
            for c, col in enumerate(columns, start=1):
                value = row.get(col)
                if value is not None:
                    ws.cell(row=r, column=c, value=value)
        for col in range(1, len(columns) + 1):
            width = max(
                (len(str(ws.cell(row=r, column=col).value or "")) for r in range(1, min(len(rows) + 2, 200))),
                default=10,
            )
            ws.column_dimensions[get_column_letter(col)].width = min(width + 2, 60)
        ws.freeze_panes = "A2"
    return wb


def save_workbook(wb: Workbook, path: str) -> None:
    wb.save(path)
