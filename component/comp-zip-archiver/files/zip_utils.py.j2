"""Zip archiving helpers — safe arcnames, files or whole directories."""
import os
import zipfile
from pathlib import Path


def _safe_arcname(path: str) -> str:
    """Sanitize an archive entry name (no absolute paths, no '..')."""
    name = path.replace("\\", "/").lstrip("/")
    return "/".join(part for part in name.split("/") if part not in ("", ".", ".."))


def zip_files(paths: list[str], output: str) -> int:
    """Zip a list of files; returns entry count."""
    with zipfile.ZipFile(output, "w", zipfile.ZIP_DEFLATED) as zf:
        for path in paths:
            if os.path.isfile(path):
                zf.write(path, _safe_arcname(path))
    return len(paths)


def zip_directory(directory: str, output: str, prefix: str = "") -> int:
    """Zip a whole directory tree under an optional arcname prefix."""
    directory = Path(directory)
    count = 0
    with zipfile.ZipFile(output, "w", zipfile.ZIP_DEFLATED) as zf:
        for root, _dirs, files in os.walk(directory):
            for fn in files:
                full = Path(root) / fn
                arcname = _safe_arcname(full.relative_to(directory).as_posix())
                zf.write(full, f"{prefix}/{arcname}" if prefix else arcname)
                count += 1
    return count
