"""Scheduler wrapper — register cron/interval jobs from one config (requires: pip install apscheduler)."""
import logging

from apscheduler.schedulers.blocking import BlockingScheduler
from apscheduler.schedulers.background import BackgroundScheduler

logger = logging.getLogger("app.scheduler")


class Scheduler:
    """Thin APScheduler wrapper: one place to register every recurring job."""

    def __init__(self, background: bool = False):
        self._scheduler = BackgroundScheduler() if background else BlockingScheduler()
        self.jobs: list[str] = []

    def register(self, name: str, fn, cron: dict | None = None, interval: dict | None = None) -> None:
        """Register one job. cron={'hour': 6, 'minute': 0} or interval={'hours': 1}."""
        if cron:
            trigger = {"trigger": "cron", **cron}
        elif interval:
            trigger = {"trigger": "interval", **interval}
        else:
            raise ValueError(f"job '{name}' needs cron= or interval=")

        def _safe():
            try:
                fn()
            except Exception as e:  # one bad job must not kill the scheduler
                logger.exception("job %s failed: %s", name, e)

        self._scheduler.add_job(_safe, id=name, replace_existing=True, **trigger)
        self.jobs.append(name)

    def start(self) -> None:
        """Blocking mode: run forever. Background mode: returns immediately."""
        if not self.jobs:
            raise RuntimeError("no jobs registered — call register() before start()")
        logger.info("starting scheduler with jobs: %s", ", ".join(self.jobs))
        self._scheduler.start()
