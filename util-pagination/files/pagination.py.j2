"""Pagination helpers — uniform page/page_size handling for APIs."""
from typing import Any, List, Optional


def clamp_page(page: Optional[int], default: int = 1, minimum: int = 1) -> int:
    try:
        value = max(int(page or default), minimum)
    except (TypeError, ValueError):
        value = default
    return value


def clamp_page_size(size: Optional[int], default: int = 20, maximum: int = 100) -> int:
    try:
        value = min(max(int(size or default), 1), maximum)
    except (TypeError, ValueError):
        value = default
    return value


def paginate(query, page: Optional[int] = None, page_size: Optional[int] = None) -> dict:
    """Paginate a SQLAlchemy query. Returns the dict shape used by every list endpoint."""
    page = clamp_page(page)
    page_size = clamp_page_size(page_size)
    total = query.count()
    items = query.offset((page - 1) * page_size).limit(page_size).all()
    return paginate_result(items, total, page, page_size)


def paginate_list(items: List[Any], page: Optional[int] = None, page_size: Optional[int] = None) -> dict:
    """Paginate an in-memory list."""
    page = clamp_page(page)
    page_size = clamp_page_size(page_size)
    total = len(items)
    start = (page - 1) * page_size
    return paginate_result(items[start:start + page_size], total, page, page_size)


def paginate_result(items: List[Any], total: int, page: int, page_size: int) -> dict:
    return {
        "items": items,
        "total": total,
        "page": page,
        "page_size": page_size,
        "pages": (total + page_size - 1) // page_size if page_size else 0,
    }
