"""JWT auth helpers: password hashing, token creation, verification, FastAPI dependency."""
import hashlib
import hmac
import os
import time
from datetime import datetime, timezone
from typing import Optional

_JWT_ALG = "HS256"
_SEP = b"."


def _secret() -> str:
    secret = os.environ.get("{{ secret_env }}", "")
    if not secret:
        raise RuntimeError("{{ secret_env }} is not set — add it to .env")
    return secret


def _b64url(data: bytes) -> bytes:
    return __import__("base64").urlsafe_b64encode(data).rstrip(b"=")


def _b64url_decode(data: str) -> bytes:
    import base64
    pad = "=" * (-len(data) % 4)
    return base64.urlsafe_b64decode(data + pad)


def hash_password(password: str) -> str:
    salt = os.urandom(16)
    digest = hashlib.pbkdf2_hmac("sha256", password.encode(), salt, 100_000)
    return f"pbkdf2${salt.hex()}${digest.hex()}"


def verify_password(password: str, stored: str) -> bool:
    try:
        _, salt_hex, digest_hex = stored.split("$")
        digest = hashlib.pbkdf2_hmac(
            "sha256", password.encode(), bytes.fromhex(salt_hex), 100_000
        )
        return hmac.compare_digest(digest.hex(), digest_hex)
    except Exception:
        return False


def create_token(user_id: str, claims: Optional[dict] = None) -> str:
    header = {"alg": _JWT_ALG, "typ": "JWT"}
    payload = {
        "sub": str(user_id),
        "iat": int(time.time()),
        "exp": int(time.time()) + int("{{ expire_days }}") * 86400,
        **(claims or {}),
    }
    import json
    h = _b64url(json.dumps(header, separators=(",", ":")).encode())
    p = _b64url(json.dumps(payload, separators=(",", ":")).encode())
    signing_input = h + _SEP + p
    sig = _b64url(hmac.new(_secret().encode(), signing_input, hashlib.sha256).digest())
    return (signing_input + _SEP + sig).decode()


def decode_token(token: str) -> dict:
    import json
    try:
        h, p, sig = token.split(".")
        signing_input = (h + "." + p).encode()
        expected = _b64url(hmac.new(_secret().encode(), signing_input, hashlib.sha256).digest())
        if not hmac.compare_digest(expected.decode(), sig):
            raise ValueError("bad signature")
        payload = json.loads(_b64url_decode(p))
        if payload.get("exp", 0) < time.time():
            raise ValueError("token expired")
        return payload
    except Exception as e:
        raise PermissionError(f"invalid token: {e}")


def get_current_user(authorization: Optional[str] = None) -> dict:
    """FastAPI dependency: pass the 'Authorization: Bearer <token>' header value.
    TODO: wire into your route as Depends(get_current_user) and load the real user row.
    """
    if not authorization or not authorization.startswith("Bearer "):
        raise PermissionError("missing Bearer token")
    return decode_token(authorization.split(" ", 1)[1])

