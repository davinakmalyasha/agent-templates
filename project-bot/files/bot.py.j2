"""Minimal Telegram long-polling bot — one dependency (requests)."""
import os
import time

import requests

TOKEN = os.environ.get("{{ token_env }}", "")
API = f"https://api.telegram.org/bot{TOKEN}"
TIMEOUT = 30


def get_updates(offset: int) -> list:
    r = requests.get(f"{API}/getUpdates", params={"offset": offset, "timeout": TIMEOUT}, timeout=TIMEOUT + 5)
    r.raise_for_status()
    return r.json().get("result", [])


def send_message(chat_id: int, text: str) -> None:
    requests.post(f"{API}/sendMessage", json={"chat_id": chat_id, "text": text}, timeout=10)


def handle(update: dict) -> None:
    message = update.get("message") or {}
    text = message.get("text") or ""
    chat_id = message.get("chat", {}).get("id")
    if not chat_id:
        return
    if text.startswith("/start"):
        send_message(chat_id, "Hello! I am alive. TODO: wire real commands here.")
    else:
        send_message(chat_id, f"You said: {text}")


def main() -> None:
    if not TOKEN:
        raise SystemExit("{{ token_env }} is not set — add it to .env")
    offset = 0
    while True:
        try:
            for update in get_updates(offset):
                offset = update["update_id"] + 1
                handle(update)
        except requests.RequestException as e:
            print(f"network error: {e}; retrying in 5s")
            time.sleep(5)


if __name__ == "__main__":
    main()
