"""Tests for the {{ project_name }} CLI."""
import pytest

from {{ project_name.replace('-', '_') }}.cli import run


def test_hello(capsys):
    assert run(["hello", "agent"]) == 0
    assert "Hello, agent!" in capsys.readouterr().out


def test_hello_default(capsys):
    run(["hello"])
    assert "world" in capsys.readouterr().out
